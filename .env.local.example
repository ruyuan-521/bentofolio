# ============================================================
# 163 邮箱 SMTP 配置（复制本文件为 .env.local 后修改！）
# ============================================================
#
# 🚨 163 SMTP 密码要用【客户端授权码】，不是你邮箱的登录密码！
#   获取方法：
#     1. 登录 mail.163.com → 顶部「设置」→ 「POP3/SMTP/IMAP」
#     2. 开启「IMAP/SMTP服务」
#     3. 点「新增授权密码」→ 短信验证后会得到一串 16 位大写字母 + 数字
#     4. 把那串授权密码填到 SMTP_PASS 里
#
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=13585010039@163.com
SMTP_PASS=这里填你163邮箱的客户端授权码（不是邮箱登录密码！）
SMTP_FROM="渊 · Yuan 个人主页 <13585010039@163.com>"

# ============================================================
# 管理员邮箱白名单（只有这些邮箱能登录后台，多个用逗号分隔）
# ============================================================
ADMIN_EMAILS=13585010039@163.com

# ============================================================
# JWT 会话密钥（建议用随机生成的一串，至少 32 位）
# ============================================================
JWT_SECRET=这里随便打一长串随机字符，比如把你163授权码再加点东西
