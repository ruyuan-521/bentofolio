# ========================================
# Next.js 环境变量模板（生产/开发通用）
# 复制此文件为 .env.local（开发）或 .env.production（服务器），然后填值
# ========================================

# --- 站点公共信息（目前项目已写死在 src/lib/constants，这里留作后续扩展用）---
NEXT_PUBLIC_SITE_NAME=渊 · Yuan
NEXT_PUBLIC_SITE_URL=https://你的域名.com

# --- 联系方式 ---
NEXT_PUBLIC_CONTACT_EMAIL=13585010039@163.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/ruyuan-521

# --- 服务器端口和监听地址（PM2 ecosystem 里也会设置，二选一）---
HOSTNAME=0.0.0.0
PORT=3000

# --- Vercel Analytics（可选，目前项目里已引入）---
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
